{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "departamentos.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grao",
    "linhas"
  ],
  "properties": {
    "grao": {
      "type": "string",
      "minLength": 1
    },
    "linhas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "departamento",
          "faturamento_26s",
          "participacao_26s_pct",
          "faturamento_base",
          "amostra_pequena"
        ],
        "properties": {
          "departamento": {
            "type": "string",
            "minLength": 1
          },
          "faturamento_26s": {
            "type": "number"
          },
          "participacao_26s_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "faturamento_base": {
            "type": "number"
          },
          "amostra_pequena": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
