{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "calor/<departamento>.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grao",
    "dimensoes",
    "colunas",
    "linhas"
  ],
  "properties": {
    "grao": {
      "type": "string",
      "minLength": 1
    },
    "dimensoes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grupo"
      ],
      "properties": {
        "grupo": {
          "type": "array",
          "items": {
            "enum": [
              "Fiéis",
              "Regulares",
              "Esporádicos",
              "Em pausa",
              "Sem segmento"
            ]
          }
        }
      }
    },
    "colunas": {
      "const": [
        "dia_semana",
        "hora",
        "grupo",
        "faturamento"
      ]
    },
    "linhas": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 23
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "number"
          }
        ],
        "minItems": 4,
        "maxItems": 4
      }
    }
  }
}
