{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cesta_subcategorias.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grao",
    "dimensoes",
    "colunas",
    "linhas"
  ],
  "properties": {
    "grao": {
      "type": "string",
      "minLength": 1
    },
    "dimensoes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subconjunto",
        "departamento",
        "subcategoria_a",
        "subcategoria_b"
      ],
      "properties": {
        "subconjunto": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(todos|(Fiéis|Regulares|Esporádicos|Em pausa)(\\+(Fiéis|Regulares|Esporádicos|Em pausa)){0,3})$"
          }
        },
        "departamento": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "subcategoria_a": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "subcategoria_b": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "colunas": {
      "const": [
        "subconjunto",
        "departamento",
        "subcategoria_a",
        "subcategoria_b",
        "cestas_par",
        "cestas_a",
        "cestas_b",
        "cestas_total",
        "suporte",
        "confianca_a_b",
        "confianca_b_a",
        "lift"
      ]
    },
    "linhas": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          {
            "type": "number",
            "minimum": 0
          }
        ],
        "minItems": 12,
        "maxItems": 12
      }
    }
  }
}
