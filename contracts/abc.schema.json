{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "abc.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grao",
    "linhas"
  ],
  "properties": {
    "grao": {
      "type": "string",
      "minLength": 1
    },
    "linhas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "departamento",
          "subcategoria",
          "posicao",
          "faturamento",
          "participacao_pct",
          "acumulado_pct",
          "classe",
          "marca_propria_pct",
          "crescimento_pct"
        ],
        "properties": {
          "departamento": {
            "type": "string",
            "minLength": 1
          },
          "subcategoria": {
            "type": "string",
            "minLength": 1
          },
          "posicao": {
            "type": "integer",
            "minimum": 1
          },
          "faturamento": {
            "type": "number"
          },
          "participacao_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "acumulado_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "classe": {
            "enum": [
              "A",
              "B",
              "C"
            ]
          },
          "marca_propria_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "crescimento_pct": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    }
  }
}
