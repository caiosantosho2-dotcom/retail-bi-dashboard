{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lojas_ranking.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grao",
    "dimensoes",
    "colunas",
    "linhas"
  ],
  "properties": {
    "grao": {
      "type": "string",
      "minLength": 1
    },
    "dimensoes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subconjunto"
      ],
      "properties": {
        "subconjunto": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(todos|(Fiéis|Regulares|Esporádicos|Em pausa)(\\+(Fiéis|Regulares|Esporádicos|Em pausa)){0,3})$"
          }
        }
      }
    },
    "colunas": {
      "const": [
        "subconjunto",
        "loja",
        "faturamento",
        "cestas",
        "ticket_medio",
        "comparavel",
        "faturamento_variacao_pct",
        "amostra_pequena",
        "faturamento_sem_segmento"
      ]
    },
    "linhas": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 9,
        "maxItems": 9,
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "number"
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": [
              "number",
              "null"
            ]
          },
          {
            "type": "boolean"
          },
          {
            "type": [
              "number",
              "null"
            ]
          },
          {
            "type": "boolean"
          },
          {
            "type": [
              "number",
              "null"
            ]
          }
        ]
      }
    }
  }
}
