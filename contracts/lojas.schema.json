{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lojas.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grao",
    "linhas"
  ],
  "properties": {
    "grao": {
      "type": "string",
      "minLength": 1
    },
    "linhas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "regiao",
          "perfil",
          "clientes_principais",
          "amostra_pequena_perfil",
          "indices"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "regiao": {
            "type": "string",
            "minLength": 1
          },
          "perfil": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(Fiéis|Regulares|Esporádicos|Em pausa)$"
          },
          "clientes_principais": {
            "type": "integer",
            "minimum": 0
          },
          "amostra_pequena_perfil": {
            "type": "boolean"
          },
          "indices": {
            "type": [
              "array",
              "null"
            ],
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "segmento",
                "pct",
                "rede_pct",
                "indice"
              ],
              "properties": {
                "segmento": {
                  "type": "string",
                  "pattern": "^(Fiéis|Regulares|Esporádicos|Em pausa)$"
                },
                "pct": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "rede_pct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "indice": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
