{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "departamentos_quadrante.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["grao", "linhas"],
  "properties": {
    "grao": {"type": "string", "minLength": 1},
    "linhas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subconjunto", "departamento", "participacao", "crescimento", "corte_participacao", "corte_crescimento", "quadrante", "valor_gap", "destaque"],
        "properties": {
          "subconjunto": {"type": "string", "pattern": "^(todos|(Fiéis|Regulares|Esporádicos|Em pausa)(\\+(Fiéis|Regulares|Esporádicos|Em pausa)){0,3})$"},
          "departamento": {"type": "string", "minLength": 1},
          "participacao": {"type": "number", "minimum": 0, "maximum": 1},
          "crescimento": {"type": "number"},
          "corte_participacao": {"type": "number", "minimum": 0, "maximum": 1},
          "corte_crescimento": {"type": "number"},
          "quadrante": {"enum": ["investir", "manter", "defender", "rever"]},
          "valor_gap": {"type": "number"},
          "destaque": {"type": ["integer", "null"], "minimum": 1, "maximum": 3}
        }
      }
    }
  }
}
