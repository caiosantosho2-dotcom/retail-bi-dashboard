{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lab_modelo.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grao",
    "linhas"
  ],
  "properties": {
    "grao": {
      "type": "string",
      "minLength": 1
    },
    "linhas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "classificador",
          "descricao",
          "corte",
          "auc",
          "auc_ic_inf",
          "auc_ic_sup",
          "auc_pr",
          "precisao",
          "recall",
          "f1",
          "alertas",
          "tn",
          "fp",
          "fn",
          "tp",
          "pausas",
          "taxa_falso_alarme"
        ],
        "properties": {
          "classificador": {
            "enum": [
              "modelo",
              "regra_simples"
            ]
          },
          "descricao": {
            "type": "string",
            "minLength": 1
          },
          "corte": {
            "type": "number",
            "minimum": 0
          },
          "auc": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "auc_ic_inf": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "auc_ic_sup": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "auc_pr": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "precisao": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "recall": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "f1": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "alertas": {
            "type": "integer",
            "minimum": 0
          },
          "tn": {
            "type": "integer",
            "minimum": 0
          },
          "fp": {
            "type": "integer",
            "minimum": 0
          },
          "fn": {
            "type": "integer",
            "minimum": 0
          },
          "tp": {
            "type": "integer",
            "minimum": 0
          },
          "pausas": {
            "type": "integer",
            "minimum": 0
          },
          "taxa_falso_alarme": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
