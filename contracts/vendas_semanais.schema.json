{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vendas_semanais.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grao",
    "linhas"
  ],
  "properties": {
    "grao": {
      "type": "string",
      "minLength": 1
    },
    "linhas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "semana_inicio",
          "faturamento",
          "faturamento_ano_anterior"
        ],
        "properties": {
          "semana_inicio": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "faturamento": {
            "type": "number"
          },
          "faturamento_ano_anterior": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    }
  }
}
