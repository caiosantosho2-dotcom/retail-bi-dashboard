{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lojas_ficha.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grao",
    "linhas"
  ],
  "properties": {
    "grao": {
      "type": "string",
      "minLength": 1
    },
    "linhas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "faturamento",
          "cestas",
          "clientes",
          "ticket_medio",
          "itens_por_cesta",
          "desconto_pct",
          "comparavel",
          "amostra_pequena",
          "cestas_variacao_pct",
          "faturamento_variacao_pct",
          "clientes_variacao_pct",
          "idas_por_cliente_variacao_pct",
          "ticket_medio_variacao_pct",
          "arvore",
          "segmentos",
          "departamentos"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "faturamento": {
            "type": "number"
          },
          "cestas": {
            "type": "integer",
            "minimum": 0
          },
          "clientes": {
            "type": "integer",
            "minimum": 0
          },
          "ticket_medio": {
            "type": "number"
          },
          "itens_por_cesta": {
            "type": "number"
          },
          "desconto_pct": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "comparavel": {
            "type": "boolean"
          },
          "amostra_pequena": {
            "type": "boolean"
          },
          "cestas_variacao_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "faturamento_variacao_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "clientes_variacao_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "idas_por_cliente_variacao_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "ticket_medio_variacao_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "arvore": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "faturamento",
                  "clientes",
                  "idas_por_cliente",
                  "ticket_medio"
                ],
                "properties": {
                  "faturamento": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "atual",
                      "base",
                      "variacao_pct"
                    ],
                    "properties": {
                      "atual": {
                        "type": "number"
                      },
                      "base": {
                        "type": "number"
                      },
                      "variacao_pct": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    }
                  },
                  "clientes": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "atual",
                      "base",
                      "variacao_pct"
                    ],
                    "properties": {
                      "atual": {
                        "type": "number"
                      },
                      "base": {
                        "type": "number"
                      },
                      "variacao_pct": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    }
                  },
                  "idas_por_cliente": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "atual",
                      "base",
                      "variacao_pct"
                    ],
                    "properties": {
                      "atual": {
                        "type": "number"
                      },
                      "base": {
                        "type": "number"
                      },
                      "variacao_pct": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    }
                  },
                  "ticket_medio": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "atual",
                      "base",
                      "variacao_pct"
                    ],
                    "properties": {
                      "atual": {
                        "type": "number"
                      },
                      "base": {
                        "type": "number"
                      },
                      "variacao_pct": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    }
                  }
                }
              }
            ]
          },
          "segmentos": {
            "type": [
              "array",
              "null"
            ],
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "segmento",
                "pct",
                "rede_pct",
                "indice"
              ],
              "properties": {
                "segmento": {
                  "type": "string",
                  "pattern": "^(Fiéis|Regulares|Esporádicos|Em pausa)$"
                },
                "pct": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "rede_pct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "indice": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                }
              }
            }
          },
          "departamentos": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "departamento",
                "pct",
                "rede_pct",
                "indice"
              ],
              "properties": {
                "departamento": {
                  "type": "string",
                  "minLength": 1
                },
                "pct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "rede_pct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "indice": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
