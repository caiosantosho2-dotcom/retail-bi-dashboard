{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "clientes_indice.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grao",
    "linhas"
  ],
  "properties": {
    "grao": {
      "type": "string",
      "minLength": 1
    },
    "linhas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "segmento",
          "faturamento_total",
          "risco_faixa"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "segmento": {
            "enum": [
              "Fiéis",
              "Regulares",
              "Esporádicos",
              "Em pausa"
            ]
          },
          "faturamento_total": {
            "type": "number"
          },
          "risco_faixa": {
            "enum": [
              "baixo",
              "medio",
              "alto",
              null
            ]
          }
        }
      }
    }
  }
}
