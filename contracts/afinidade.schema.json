{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "afinidade.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grao",
    "linhas"
  ],
  "properties": {
    "grao": {
      "type": "string",
      "minLength": 1
    },
    "linhas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segmento",
          "departamento",
          "faturamento",
          "participacao_segmento_pct",
          "participacao_base_pct",
          "indice",
          "compradores",
          "amostra_pequena"
        ],
        "properties": {
          "segmento": {
            "enum": [
              "Fiéis",
              "Regulares",
              "Esporádicos",
              "Em pausa"
            ]
          },
          "departamento": {
            "type": "string",
            "minLength": 1
          },
          "faturamento": {
            "type": "number"
          },
          "participacao_segmento_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "participacao_base_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "indice": {
            "type": "number",
            "minimum": 0
          },
          "compradores": {
            "type": "integer",
            "minimum": 0
          },
          "amostra_pequena": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
