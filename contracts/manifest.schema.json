{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "manifest.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versao_contrato",
    "gerado_em",
    "base_hash",
    "periodo_base",
    "janelas",
    "rag_commit",
    "rag_sujo",
    "modelo",
    "bytes_abertura",
    "arquivos"
  ],
  "properties": {
    "versao_contrato": {
      "const": "1.1"
    },
    "gerado_em": {
      "type": "string",
      "format": "date-time"
    },
    "base_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "periodo_base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inicio",
        "fim"
      ],
      "properties": {
        "inicio": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "fim": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "janelas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "4s",
        "13s",
        "26s",
        "base"
      ],
      "properties": {
        "4s": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semana_ini",
            "semana_fim",
            "data_ini",
            "data_fim"
          ],
          "properties": {
            "semana_ini": {
              "type": "integer",
              "minimum": 0
            },
            "semana_fim": {
              "type": "integer",
              "minimum": 0
            },
            "data_ini": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "data_fim": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "13s": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semana_ini",
            "semana_fim",
            "data_ini",
            "data_fim"
          ],
          "properties": {
            "semana_ini": {
              "type": "integer",
              "minimum": 0
            },
            "semana_fim": {
              "type": "integer",
              "minimum": 0
            },
            "data_ini": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "data_fim": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "26s": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semana_ini",
            "semana_fim",
            "data_ini",
            "data_fim"
          ],
          "properties": {
            "semana_ini": {
              "type": "integer",
              "minimum": 0
            },
            "semana_fim": {
              "type": "integer",
              "minimum": 0
            },
            "data_ini": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "data_fim": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        },
        "base": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semana_ini",
            "semana_fim",
            "data_ini",
            "data_fim"
          ],
          "properties": {
            "semana_ini": {
              "type": "integer",
              "minimum": 0
            },
            "semana_fim": {
              "type": "integer",
              "minimum": 0
            },
            "data_ini": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "data_fim": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        }
      }
    },
    "rag_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "rag_sujo": {
      "type": "boolean"
    },
    "modelo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limiar_alerta",
        "corte_medio",
        "auc_modelo",
        "auc_regra_simples",
        "pausas_esperadas",
        "alertas",
        "risco_por_segmento"
      ],
      "properties": {
        "limiar_alerta": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "corte_medio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "auc_modelo": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "auc_regra_simples": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pausas_esperadas": {
          "type": "number",
          "minimum": 0
        },
        "alertas": {
          "type": "integer",
          "minimum": 0
        },
        "risco_por_segmento": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "segmento",
              "clientes",
              "pausas_esperadas",
              "alertas"
            ],
            "properties": {
              "segmento": {
                "type": "string"
              },
              "clientes": {
                "type": "integer",
                "minimum": 0
              },
              "pausas_esperadas": {
                "type": "number",
                "minimum": 0
              },
              "alertas": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "bytes_abertura": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1572864
    },
    "arquivos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nome",
          "linhas",
          "bytes",
          "sha256"
        ],
        "properties": {
          "nome": {
            "type": "string"
          },
          "linhas": {
            "type": "integer",
            "minimum": 0
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
