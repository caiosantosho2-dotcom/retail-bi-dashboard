{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "regioes_segmento.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grao",
    "dimensoes",
    "colunas",
    "linhas"
  ],
  "properties": {
    "grao": {
      "type": "string",
      "minLength": 1
    },
    "dimensoes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "periodo",
        "regiao",
        "grupo"
      ],
      "properties": {
        "periodo": {
          "type": "array",
          "items": {
            "enum": [
              "4s",
              "13s",
              "26s",
              "base"
            ]
          }
        },
        "regiao": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "grupo": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(Fiéis|Regulares|Esporádicos|Em pausa|Sem segmento)$"
          }
        }
      }
    },
    "colunas": {
      "const": [
        "periodo",
        "regiao",
        "grupo",
        "faturamento"
      ]
    },
    "linhas": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "number"
          }
        ]
      }
    }
  }
}
