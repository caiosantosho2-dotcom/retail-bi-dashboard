{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "perfis.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grao",
    "linhas"
  ],
  "properties": {
    "grao": {
      "type": "string",
      "minLength": 1
    },
    "linhas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "perfil",
          "lojas",
          "clientes_principais",
          "faturamento"
        ],
        "properties": {
          "perfil": {
            "enum": [
              "Fiéis",
              "Regulares",
              "Esporádicos",
              "Em pausa",
              "Amostra pequena"
            ]
          },
          "lojas": {
            "type": "integer",
            "minimum": 0
          },
          "clientes_principais": {
            "type": "integer",
            "minimum": 0
          },
          "faturamento": {
            "type": "number"
          }
        }
      }
    }
  }
}
