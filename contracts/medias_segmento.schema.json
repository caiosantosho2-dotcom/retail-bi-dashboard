{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "medias_segmento.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grao",
    "linhas"
  ],
  "properties": {
    "grao": {
      "type": "string",
      "minLength": 1
    },
    "linhas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segmento",
          "atributo",
          "valor_medio",
          "percentil_medio"
        ],
        "properties": {
          "segmento": {
            "enum": [
              "Fiéis",
              "Regulares",
              "Esporádicos",
              "Em pausa"
            ]
          },
          "atributo": {
            "enum": [
              "recencia",
              "frequencia",
              "valor",
              "clv",
              "sensibilidade_desconto",
              "variedade_departamentos"
            ]
          },
          "valor_medio": {
            "type": [
              "number",
              "null"
            ]
          },
          "percentil_medio": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    }
  }
}
