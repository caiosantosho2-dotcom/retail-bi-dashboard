{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "clientes/<segmento>.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grao",
    "linhas"
  ],
  "properties": {
    "grao": {
      "type": "string",
      "minLength": 1
    },
    "linhas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "segmento",
          "semanas_sem_comprar",
          "atributos",
          "risco",
          "historico_semanal",
          "top_departamentos"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "segmento": {
            "enum": [
              "Fiéis",
              "Regulares",
              "Esporádicos",
              "Em pausa"
            ]
          },
          "semanas_sem_comprar": {
            "type": "integer",
            "minimum": 0
          },
          "atributos": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "recencia",
              "frequencia",
              "valor",
              "clv",
              "sensibilidade_desconto",
              "variedade_departamentos"
            ],
            "properties": {
              "recencia": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "valor",
                  "percentil"
                ],
                "properties": {
                  "valor": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "percentil": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              },
              "frequencia": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "valor",
                  "percentil"
                ],
                "properties": {
                  "valor": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "percentil": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              },
              "valor": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "valor",
                  "percentil"
                ],
                "properties": {
                  "valor": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "percentil": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              },
              "clv": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "valor",
                  "percentil"
                ],
                "properties": {
                  "valor": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "percentil": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              },
              "sensibilidade_desconto": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "valor",
                  "percentil"
                ],
                "properties": {
                  "valor": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "percentil": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              },
              "variedade_departamentos": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "valor",
                  "percentil"
                ],
                "properties": {
                  "valor": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "percentil": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              }
            }
          },
          "risco": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "score",
              "faixa"
            ],
            "properties": {
              "score": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "faixa": {
                "enum": [
                  "baixo",
                  "medio",
                  "alto",
                  null
                ]
              }
            }
          },
          "historico_semanal": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "top_departamentos": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "departamento",
                "gasto_pct"
              ],
              "properties": {
                "departamento": {
                  "type": "string",
                  "minLength": 1
                },
                "gasto_pct": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
